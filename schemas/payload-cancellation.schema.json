{
  "additionalProperties": false,
  "properties": {
    "action_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Sha256",
      "type": "string"
    },
    "authorization_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9._:-]{0,127})$",
      "title": "Authorization Id",
      "type": "string"
    },
    "decision_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Hash",
      "type": "string"
    },
    "evidence_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Sha256"
    },
    "kill_epoch": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Kill Epoch",
      "type": "integer"
    },
    "status": {
      "enum": [
        "SIGNALLED",
        "CONFIRMED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "action_sha256",
    "authorization_id",
    "decision_hash",
    "kill_epoch",
    "status"
  ],
  "title": "CancellationEventPayload",
  "type": "object"
}
